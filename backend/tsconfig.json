{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*", "schemas/**/*", "services/**/*", "scheduler/**/*", "tests/**/*", "scripts/**/*", "data/**/*"]
}
